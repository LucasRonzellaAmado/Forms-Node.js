# ============================================================
# CONFIGURACAO DO PROJETO - Entenda sua Bexiga
# ============================================================
# Copie este arquivo para ".env" e ajuste os valores conforme
# necessario. O ".env" nunca deve ser commitado no Git.
# ============================================================

# Porta em que o servidor Node.js vai rodar
PORT=3000

# Ambiente: development | production
NODE_ENV=development

# Nivel de log: error | warn | info | http | debug
LOG_LEVEL=info

# Nome do arquivo Excel de BACKUP LOCAL (contingencia caso o
# Google Sheets fique fora do ar). Fica dentro da pasta /data
EXCEL_FILE_NAME=avaliacoes-backup.xlsx

# ============================================================
# GOOGLE SHEETS (planilha online - destino principal)
# ============================================================
# 100% gratuito, sem Google Cloud, sem cartao de credito.
# Veja o passo a passo completo no README.md, secao
# "Configurar o Google Sheets (grátis, sem Google Cloud)".

# Cole aqui a URL gerada ao publicar o Google Apps Script como
# "Web App" (termina em /exec). Enquanto estiver vazia, as
# respostas ficam so no backup local.
GOOGLE_APPS_SCRIPT_URL=

# Origem(ns) permitidas para chamadas de API (CORS).
# Use "*" para liberar geral, ou uma lista separada por virgula,
# ex: https://meusite.com,https://www.meusite.com
CORS_ORIGIN=*

# Limite de requisicoes por IP na rota de envio do formulario
# (protecao basica contra abuso / spam)
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX_REQUESTS=60
